{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "club_owner", "admin"] },
        "interests": { "type": "array", "items": { "type": "string" } },
        "onboarded": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Event": {
      "title": "Campus Event",
      "description": "Details about a campus event.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "shortSummary": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "venue": { "type": "string" },
        "organizerId": { "type": "string" },
        "organizerName": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "registrationUrl": { "type": "string" },
        "isFree": { "type": "boolean" },
        "price": { "type": "number" },
        "attendeeCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "organizerId", "status"]
    },
    "Club": {
      "title": "Student Organization",
      "description": "A club or department that organizes events.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "logoUrl": { "type": "string" },
        "ownerId": { "type": "string" },
        "category": { "type": "string" },
        "socialLinks": { "type": "object" },
        "followerCount": { "type": "integer" }
      },
      "required": ["name", "ownerId"]
    },
    "Notification": {
      "title": "In-app Notification",
      "description": "Alerts for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "actionUrl": { "type": "string" }
      },
      "required": ["userId", "title", "message", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Public and pending event listings."
    },
    "/clubs/{clubId}": {
      "schema": "Club",
      "description": "Registered campus organizations."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User-specific alerts."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "type": "object", "properties": { "eventId": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" } } },
      "description": "User saved events."
    },
    "/users/{userId}/rsvps/{rsvpId}": {
      "schema": { "type": "object", "properties": { "eventId": { "type": "string" }, "status": { "type": "string" }, "timestamp": { "type": "string", "format": "date-time" } } },
      "description": "User event registrations."
    },
    "/events/{eventId}/registrations/{registrationId}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "userName": { "type": "string" },
          "userEmail": { "type": "string" },
          "studentId": { "type": "string" },
          "department": { "type": "string" },
          "year": { "type": "string" },
          "specialRequirements": { "type": "string" },
          "registeredAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "userName", "userEmail", "studentId", "department", "year", "registeredAt"]
      },
      "description": "Attendees registered for a specific event."
    }
  }
}

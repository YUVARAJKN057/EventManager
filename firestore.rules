rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "yuvarajkn6360@gmail.com"
      );
    }

    // User profiles and subcollections
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId && 
               data.email is string && data.email.size() <= 256 &&
               data.role in ['student', 'club_owner', 'admin'] &&
               (data.interests is list || !('interests' in data)) &&
               (data.bookmarks is list || !('bookmarks' in data)) &&
               (data.rsvps is list || !('rsvps' in data));
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (incoming().role == 'student' || isAdmin());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    (incoming().role == existing().role || isAdmin()) &&
                    incoming().email == existing().email;

      // Notifications Subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow create: if isOwner(userId) || isAdmin(); // Users can create for themselves, or admin can
      }

      // Bookmarks Subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // RSVPs Subcollection
      match /rsvps/{rsvpId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      }
    }

    // Admins list (bootstrapped)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isAdmin();
    }

    // Clubs
    match /clubs/{clubId} {
      function isValidClub(data) {
        return data.name is string && data.name.size() <= 100 &&
               data.ownerId is string && data.ownerId.size() <= 128;
      }
      allow read: if true;
      allow create: if isSignedIn() && isValidClub(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if (isOwner(existing().ownerId) || isAdmin()) && isValidClub(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isAdmin();
    }

    // Events
    match /events/{eventId} {
      function isValidEvent(data) {
        return data.title is string && data.title.size() <= 200 &&
               data.description is string && data.description.size() <= 5000 &&
               data.organizerId is string &&
               data.date is timestamp &&
               data.status in ['pending', 'approved', 'rejected'] &&
               data.location is string &&
               data.categories is list;
      }
      allow get: if true;
      allow list: if resource.data.status == 'approved' || isAdmin();
      
      allow create: if isSignedIn() && isValidEvent(incoming()) && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/clubs/$(incoming().organizerId)) && 
         get(/databases/$(database)/documents/clubs/$(incoming().organizerId)).data.ownerId == request.auth.uid)
      );
      
      allow update: if (isSignedIn() && (
        // Club owner can update
        (get(/databases/$(database)/documents/clubs/$(existing().organizerId)).data.ownerId == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'date', 'location', 'categories', 'imageUrl', 'registrationUrl'])) ||
        // Admin can approve
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        // User can RSVP (increment/decrement attendeeCount)
        (incoming().diff(existing()).affectedKeys().hasOnly(['attendeeCount']) && 
         math.abs(incoming().attendeeCount - existing().attendeeCount) <= 1)
      ));
      allow delete: if isAdmin();

      // Registrations Subcollection
      match /registrations/{registrationId} {
        function isValidRegistration(data) {
          return data.userId is string && data.userId.size() <= 128 &&
                 data.userName is string && data.userName.size() <= 200 &&
                 data.userEmail is string && data.userEmail.size() <= 256 &&
                 data.studentId is string && data.studentId.size() <= 100 &&
                 data.department is string && data.department.size() <= 100 &&
                 data.year is string && data.year.size() <= 50 &&
                 (!('specialRequirements' in data) || (data.specialRequirements is string && data.specialRequirements.size() <= 1000)) &&
                 data.registeredAt is timestamp;
        }

        allow read: if isSignedIn() && (
          isOwner(resource.data.userId) || 
          isAdmin() || 
          (exists(/databases/$(database)/documents/clubs/$(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId)) && 
           get(/databases/$(database)/documents/clubs/$(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId)).data.ownerId == request.auth.uid)
        );

        allow create: if isSignedIn() && 
                      isOwner(incoming().userId) && 
                      isValidRegistration(incoming()) &&
                      incoming().registeredAt == request.time;
      }
    }
  }
}
